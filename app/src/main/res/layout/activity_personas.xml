<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingHorizontal="16dp">
        <Button android:id="@+id/backButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/inicio" />
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="0dp"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />
    </LinearLayout>
    <TextView android:id="@+id/status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingHorizontal="24dp" android:paddingVertical="12dp"
        android:accessibilityLiveRegion="polite" />
    <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/personas"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingHorizontal="16dp">
        <Button android:id="@+id/refreshButton" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/recargar" />
        <Button android:id="@+id/addButton" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/agregar" />
    </LinearLayout>
</LinearLayout>

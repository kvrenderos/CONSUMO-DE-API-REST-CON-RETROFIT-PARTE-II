<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="24dp" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/configurar_api" android:textAppearance="?attr/textAppearanceHeadlineSmall" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginVertical="16dp" android:text="@string/config_instrucciones" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/alumnos" />
        <EditText android:id="@+id/alumnosUrlInput" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:hint="@string/url_hint" android:inputType="textUri" android:autofillHints="" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profesores" />
        <EditText android:id="@+id/profesoresUrlInput" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:hint="@string/url_hint" android:inputType="textUri" android:autofillHints="" />
        <Button android:id="@+id/guideButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/usar_guia" />
        <Button android:id="@+id/localButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/usar_local" />
        <Button android:id="@+id/saveConfig" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/guardar_config" />
        <Button android:id="@+id/backButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/cancelar" />
    </LinearLayout>
</ScrollView>

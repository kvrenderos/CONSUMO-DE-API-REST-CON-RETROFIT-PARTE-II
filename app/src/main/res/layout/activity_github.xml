<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <Button android:id="@+id/backButton" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginHorizontal="16dp"
        android:text="@string/back_to_dogs" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="16dp" android:text="@string/github_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />
    <androidx.appcompat.widget.SearchView android:id="@+id/searchUsername"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp" app:iconifiedByDefault="false"
        app:queryHint="@string/username_hint" android:inputType="textUri" />
    <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
        android:visibility="gone" />
    <TextView android:id="@+id/status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="16dp"
        android:accessibilityLiveRegion="polite" android:text="@string/github_instructions" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/repositories"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" />
    <Button android:id="@+id/loadMore" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginHorizontal="16dp"
        android:visibility="gone" android:text="@string/load_more" />
</LinearLayout>

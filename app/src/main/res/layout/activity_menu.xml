<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/escuela_title" android:textAppearance="?attr/textAppearanceHeadlineMedium" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/escuela_subtitle" />
        <Button android:id="@+id/alumnosButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/alumnos" />
        <Button android:id="@+id/profesoresButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/profesores" />
        <Button android:id="@+id/configButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/configurar_api" />
        <TextView android:id="@+id/apiUrl" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceBodySmall" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="32dp" android:text="@string/guia10_title"
            android:textAppearance="?attr/textAppearanceTitleMedium" />
        <Button android:id="@+id/dogsButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/perros" />
        <Button android:id="@+id/githubButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/open_github" />
    </LinearLayout>
</ScrollView>
